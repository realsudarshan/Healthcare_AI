# generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# Public origin of this app — used for metadata/OG URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq — primary chat models
# https://console.groq.com
GROQ_API_KEY=****

# Optional — only if you enable openai/* models
# OPENAI_API_KEY=

# MixRoute — OpenAI-compatible multi-model gateway (https://mixroute.ai)
MIXROUTE_API_KEY=****
MIXROUTE_BASE_URL=https://api.mixroute.ai/v1

# Required — chat auth + history
POSTGRES_URL=****

# Optional — resumable streams + production IP rate limits. Chat works without it.
REDIS_URL=

# Optional — S3-compatible object storage for image/file attachments.
# Chat works without it. Point these at any provider:
#
#   Backblaze B2 (no card required — what this project uses):
#     S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#     S3_REGION=<region>      (must match the endpoint, e.g. us-east-005)
#     S3_FORCE_PATH_STYLE=false
#
#   Cloudflare R2:
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_REGION=auto
#     S3_FORCE_PATH_STYLE=false
#
#   AWS S3:
#     S3_ENDPOINT=            (leave empty — derived from region)
#     S3_REGION=us-east-1
#     S3_FORCE_PATH_STYLE=false
#
#   Local MinIO (docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"):
#     S3_ENDPOINT=http://localhost:9000
#     S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional — set only if the bucket is publicly readable at a stable URL.
# When unset, uploads are proxied through /api/files and the bucket stays private.
S3_PUBLIC_URL=

# LangChain FastAPI backend (ai-backend/)
LANGCHAIN_API_URL=http://localhost:8001
LANGCHAIN_API_KEY=
